rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ═══════════════════════════════════════════════════════════════════════════
    // تطبيق تسهيل - قواعد أمان Firebase Firestore
    // ═══════════════════════════════════════════════════════════════════════════
    // القراءة متاحة للجميع بدون تسجيل دخول (طلاب العلم وزوار التطبيق)
    // الكتابة والتعديل والحذف مقيدة بالمدير المسجل دخوله عبر Firebase Auth فقط
    // ═══════════════════════════════════════════════════════════════════════════

    // الأقسام العلمية (categories)
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // الشيوخ والعلماء (sheikhs)
    match /sheikhs/{sheikhId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // الكتب والمتون (books)
    match /books/{bookId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // السلاسل والشروحات (series)
    match /series/{seriesId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // الدروس العلمية (lessons)
    match /lessons/{lessonId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // الإعدادات العامة وبيانات التطبيق وتحديثات الإصدارات (settings/app_update)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // الإشعارات والتنبيهات الحية (notifications)
    match /notifications/{notificationId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // القاعدة الافتراضية لباقي المجموعات
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}

